{
  "name": "op2gw",
  "version": "0.1.0",
  "private": true,
  "description": "op2gw — a standalone OpenAI v1-compatible gateway that fronts the OpenCode Zen anonymous free lane, with a multi-exit dynamic IP pool, live catalog, structured logging, self-healing, and a built-in debug web UI.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "op2gw": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "serve": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\""
  },
  "keywords": [
    "openai",
    "gateway",
    "opencode",
    "opencode-zen",
    "free-llm",
    "proxy-pool",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^7.16.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
